# Copy to .env, fill in, then encrypt in place: dotenvx encrypt  (writes the key to .env.keys)
DISCORD_TOKEN=your-discord-bot-token
# Optional:
# PREFIXES="? ,"              # command prefixes, space separated (default: ? and ,)
# DEFAULT_DICE=20             # sides for bare rolls like "?roll +2"
# D10_ONLY_ROLLS="123 456"    # channel IDs where only d10s may be rolled
